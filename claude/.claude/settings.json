{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "model": "sonnet",
  "modelPicker": {
    "options": [
      {
        "model": "gemma4-31b",
        "label": "Gemma4-31B (local)",
        "description": "Local vLLM, gpu0 — 262144 token context",
        "behavesAs": "claude-sonnet-5"
      },
      {
        "model": "qwen3.8-27b",
        "label": "Qwen3.8-27B (local, via router)",
        "description": "Local vLLM, gpu2 — 262144 token context",
        "behavesAs": "claude-sonnet-5"
      }
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/atosh/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-mem@thedotmack": true,
    "last30days@last30days-skill": true,
    "cc-plugin-you-should-know@builtin": true,
    "pstack@cursor-plugins": true,
    "cloudflare@cloudflare": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "qwen3.8-27b-int4-dflash2": {
      "effortLevel": "high"
    },
    "qwen3.8-27b": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "advisorModel": "opus",
  "skipWorkflowUsageWarning": true
}
